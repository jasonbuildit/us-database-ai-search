# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional
ANTHROPIC_MODEL=claude-sonnet-4-6
POSTGRES_PASSWORD=postgres
EMBED_MODEL=nomic-embed-text

# Path on the host that contains toc.dat + the .dat.gz segments.
# Copy the dump off /Volumes/JAC to a local SSD first; do not point at the external drive.
DUMP_DIR=./dump

# Metabase admin (used by metabase/setup_metabase.py on first run).
# Email must parse as a real address; password must not be in Metabase's
# common-password list.
MB_ADMIN_EMAIL=admin@local.test
MB_ADMIN_PASSWORD=Smoke!Tests-2026
