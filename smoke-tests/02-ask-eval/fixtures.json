    }
  },
  {
    "id": "recipient_count_universities",
    "q": "How many recipients in rpt.recipient_lookup have 'UNIVERSITY' in their legal_business_name?",
    "expect": {
      "row_count_eq": 1,
      "sql_contains_any": ["UNIVERSITY", "ILIKE", "ilike"]
    }
  },
